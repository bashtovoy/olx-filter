{
  "manifest_version": 3,
  "name": "OLX Фільтр",
  "version": "0.2.1",
  "description": "Приховує ТОП і рекламу, чистить видачу, задає сортування, ціну, стан і вигляд на OLX.ua",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.olx.ua/*",
    "https://olx.ua/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_title": "OLX Фільтр",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.olx.ua/*",
        "https://olx.ua/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.olx.ua/*",
        "https://olx.ua/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "111"
}
